# .env.local руу хуулж бөглөнө

# Unsplash (npm run images:fetch)
UNSPLASH_ACCESS_KEY=

# PostgreSQL. Локалд: `npm run db:start` (prisma dev) хэвлэсэн TCP холбоосыг тавина
DATABASE_URL="postgres://postgres:postgres@localhost:51221/template1?sslmode=disable"
# Локал prisma dev (PGlite) зэрэг холболт даахгүй — зөвхөн локалд 1. Жинхэнэ Postgres-д хоосон орхино
DATABASE_POOL_MAX=1

# /admin — нууц үг ба cookie гарын үсгийн түлхүүр (openssl rand -hex 32)
ADMIN_PASSWORD=
ADMIN_SECRET=
